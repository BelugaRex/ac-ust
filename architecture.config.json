    {
      "name": "legacy PWM alarm metadata clears use the clock intent primitive",
      "files": ["background.js"],
      "requirePatterns": [
        "function\\s+setPwmClockIntent\\s*\\("
      ],
      "forbidPatterns": [
        "\\bschedule\\.alarmCreatedAt\\s*=\\s*0",
        "\\bschedule\\.alarmDelayMinutes\\s*=\\s*0"
      ]
    },
    {
      "name": "verified PWM clock commits use one snapshot and replay facade",
      "files": ["background.js"],
      "requirePatterns": [
        "function\\s+snapshotPwmClockIntentState\\s*\\(",
        "function\\s+replayPwmClockIntentState\\s*\\(",
        "function\\s+snapshotVerifiedPwmClockState\\s*\\(",
        "pwmAlarmWriteOwner\\s*:\\s*Number\\(pwmAlarmWriteOwner\\)",
        "function\\s+replayVerifiedPwmClockState\\s*\\(",
        "isPwmAlarmWriteOwnerCurrent\\s*\\(\\s*clockState\\?\\.pwmAlarmWriteOwner\\s*\\)",
        "function\\s+claimPwmAlarmWriteOwner\\s*\\(",
        "async\\s+function\\s+createPwmAlarmFromPlanWithReceipt\\s*\\(",
        "const\\s+alarmWriteIsCurrent\\s*=\\s*\\(\\s*\\)\\s*=>",
        "ensureCurrent\\s*:\\s*\\(\\s*\\)\\s*=>",
        "async\\s+function\\s+persistOwnedPwmAlarmFailure\\s*\\(",
        "setNextTriggerAt\\s*\\(\\s*clockState\\.nextTriggerAt\\s*,\\s*\\{\\s*plannedAt\\s*:\\s*clockState\\.smartClockPlannedAt"
      ]
    },
    {
      "name": "PWM retry fields use the atomic replacement primitive",
      "files": ["background.js"],
      "requirePatterns": [
        "function\\s+clearPwmRetryState\\s*\\(",
        "replaceSchedulePwmRetryState\\s*\\("
      ],
      "forbidPatterns": [
        "\\bschedule\\.pwmRetryKind\\s*=(?!=)",
        "\\bschedule\\.pwmRetryBoundaryAt\\s*=(?!=)",
        "\\bschedule\\.pwmRetryScheduledAt\\s*=(?!=)"
      ]
    },
    {
      "name": "page timer lifecycle commits use schedule mutation primitives",
      "files": ["background.js"],
      "requirePatterns": [
        "function\\s+claimPageTimerWriteOwner\\s*\\(",
        "function\\s+invalidatePageTimerWriteOwner\\s*\\(",
        "let\\s+pageTimerRetryAlarmWriteGeneration\\s*=\\s*0",
        "function\\s+writePageTimerRetryAlarm\\s*\\(",
        "function\\s+clearPageTimerRetryAlarmPhysical\\s*\\(",
        "isPageTimerWriteOwnerCurrent\\s*\\(\\s*pageTimerWriteOwner\\s*\\)",
        "pageTimerStale\\s*:\\s*true",
        "function\\s+clearPageTimerProofState\\s*\\(\\s*\\)\\s*\\{\\s*const\\s+pageTimerWriteOwner\\s*=\\s*invalidatePageTimerWriteOwner\\s*\\(\\s*\\)",
        "replaceSchedulePageTimerRetryState\\s*\\(\\s*schedule\\s*[,)]",
        "recordSchedulePageTimerFailureState\\s*\\(\\s*schedule\\s*,",
        "clearSchedulePageTimerProofState\\s*\\(\\s*schedule\\s*\\)",
        "recordSchedulePageTimerProofState\\s*\\(\\s*schedule\\s*,"
      ],
      "forbidPatterns": [
        "\\bschedule\\.pageTimerMinutes\\s*=(?!=)",
        "\\bschedule\\.pageTimerTargetAt\\s*=(?!=)",
        "\\bschedule\\.pageTimerRetryAt\\s*=(?!=)",
        "\\bschedule\\.pageTimerRetryMinutes\\s*=(?!=)"
      ]
    },
    {
      "name": "PWM retry descriptors remain browser independent",
      "files": ["pwm-retry.js"],
      "forbidPatterns": [
        "\\bchrome\\s*\\.",
        "\\bdocument\\s*\\.",
        "\\bwindow\\s*\\.",
        "\\blocalStorage\\b",
        "\\bfetch\\s*\\(",
        "\\bimportScripts\\s*\\("
      ]
    },
    {
