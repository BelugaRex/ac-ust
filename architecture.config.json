{
  "schemaVersion": 1,
  "entrypoints": {
    "serviceWorker": {
      "file": "background.js",
      "imports": [
        "i18n.js",
        "sync-helpers.js",
        "schedule-mutations.js",
        "pwm-retry.js",
        "pwm-phase.js",
        "smart-recovery.js",
        "interval-recovery.js",
        "recovery-coordinator.js",
        "smart-mode.js"
      ]
    },
    "contentScripts": [
      {
        "matches": ["https://w5.ab.ust.hk/njggt/app/home"],
        "js": ["page-confirm.js"],
        "run_at": "document_start",
        "world": "MAIN",
        "all_frames": false
      },
      {
        "matches": ["https://w5.ab.ust.hk/njggt/app/home"],
        "js": ["billing-helpers.js", "content.js"],
        "run_at": "document_idle",
        "all_frames": false
      }
    ],
    "documents": [
      {
        "file": "popup.html",
        "scripts": ["i18n.js", "popup-diagnostic-fallback.js", "billing-helpers.js", "smart-mode.js", "pwm-retry.js", "pwm-phase.js", "popup.js"]
      },
      {
        "file": "offscreen.html",
        "scripts": ["offscreen.js"]
      }
    ],
    "dynamicInjections": [
      {
        "source": "background.js",
        "files": ["billing-helpers.js", "content.js"]
      },
      {
        "source": "background.js",
        "files": ["page-confirm.js"]
      }
    ]
  },
  "interfaces": [
    {
      "name": "translations",
      "provider": {
        "file": "i18n.js",
        "symbols": ["I18n"]
      },
      "consumers": [
        {
          "file": "background.js",
          "symbols": ["I18n"]
        },
        {
          "file": "popup.js",
          "symbols": ["I18n"]
        },
        {
          "file": "popup-diagnostic-fallback.js",
          "symbols": ["I18n"]
        }
      ]
    },
    {
      "name": "balance decisions",
      "provider": {
        "file": "billing-helpers.js",
        "symbols": [
          "parseBalanceMinutes",
          "estimateBalanceExhaustion",
          "isBalanceEstimateUrgent"
        ]
      },
      "consumers": [
        {
          "file": "content.js",
          "symbols": ["parseBalanceMinutes"]
        },
        {
          "file": "popup.js",
          "symbols": ["estimateBalanceExhaustion", "isBalanceEstimateUrgent"]
        }
      ]
    },
    {
      "name": "schedule sync decisions",
      "provider": {
        "file": "sync-helpers.js",
        "symbols": [
          "composeSyncPayload",
          "computePhaseAdoption",
          "computeConfigDiff",
          "parsePageTimerValue",
          "isPageTimerProofFresh",
          "computePageTimerAdoption",
          "planComfortStart"
        ]
      },
      "consumers": [
        {
          "file": "background.js",
          "symbols": [
            "composeSyncPayload",
            "computePhaseAdoption",
            "computeConfigDiff",
            "isPageTimerProofFresh",
            "computePageTimerAdoption",
            "planComfortStart"
          ]
        }
      ]
    },
    {
      "name": "schedule clock mutations",
      "provider": {
        "file": "schedule-mutations.js",
        "symbols": ["setScheduleNextTrigger"]
      },
      "consumers": [
        {
          "file": "background.js",
          "symbols": ["setScheduleNextTrigger"]
        }
      ]
    },
    {
      "name": "PWM retry descriptors",
      "provider": {
        "file": "pwm-retry.js",
        "symbols": [
          "PWM_RETRY_KINDS",
          "getPwmRetryDescriptor",
          "normalizePwmRetryKind"
        ]
      },
      "consumers": [
        {
          "file": "background.js",
          "symbols": ["getPwmRetryDescriptor", "normalizePwmRetryKind"]
        },
        {
          "file": "pwm-phase.js",
          "symbols": ["getPwmRetryDescriptor"]
        },
        {
          "file": "popup.js",
          "symbols": ["getPwmRetryDescriptor"]
        }
      ]
    },
    {
      "name": "PWM phase decisions",
      "provider": {
        "file": "pwm-phase.js",
        "symbols": [
          "planPwmStep",
          "planPwmRecovery",
          "reconcilePwmTrigger",
          "planNextSmartWeatherPrefetch",
          "smartWeatherTargetBoundaryAt",
          "nextHalfHourBoundary",
          "halfHourBoundaryAtOrBefore",
          "smartModePageTimerTargetAt",
          "planSmartModeOnWindow",
          "planSmartOnRetryExceptionRecovery",
          "planSmartOnAfterConfirmedOff",
          "classifySmartOnClock",
          "alignSmartModeNextTrigger"
        ]
      },
      "consumers": [
        {
          "file": "background.js",
          "symbols": [
            "planPwmStep",
            "planPwmRecovery",
            "reconcilePwmTrigger",
            "planNextSmartWeatherPrefetch",
            "smartWeatherTargetBoundaryAt",
            "halfHourBoundaryAtOrBefore",
            "smartModePageTimerTargetAt",
            "planSmartModeOnWindow",
            "planSmartOnRetryExceptionRecovery",
            "planSmartOnAfterConfirmedOff",
            "classifySmartOnClock",
            "alignSmartModeNextTrigger"
          ]
        },
        {
          "file": "popup.js",
          "symbols": ["classifySmartOnClock"]
        },
        {
          "file": "recovery-coordinator.js",
          "symbols": ["classifySmartOnClock"]
        },
        {
          "file": "smart-recovery.js",
          "symbols": ["planSmartModeOnWindow"]
        }
      ]
    },
    {
      "name": "smart recovery decisions",
      "provider": {
        "file": "smart-recovery.js",
        "symbols": ["planSmartRecovery"]
      },
      "consumers": [
        {
          "file": "recovery-coordinator.js",
          "symbols": ["planSmartRecovery"]
        },
        {
          "file": "background.js",
          "symbols": ["planSmartRecovery"]
        }
      ]
    },
    {
      "name": "interval recovery decisions",
      "provider": {
        "file": "interval-recovery.js",
        "symbols": ["planIntervalRecovery"]
      },
      "consumers": [
        {
          "file": "recovery-coordinator.js",
          "symbols": ["planIntervalRecovery"]
        }
      ]
    },
    {
      "name": "PWM lifecycle recovery decisions",
      "provider": {
        "file": "recovery-coordinator.js",
        "symbols": ["planPwmLifecycleRecovery"]
      },
      "consumers": [
        {
          "file": "background.js",
          "symbols": ["planPwmLifecycleRecovery"]
        }
      ]
    },
    {
      "name": "smart mode decisions",
      "provider": {
        "file": "smart-mode.js",
        "symbols": [
          "normalizeSmartSensitivity",
          "computeSmartOnMinutes",
          "prepareSmartWeatherDecision",
          "consumeSmartWeatherDecision",
          "sensitivityToK",
          "equivalentTemperature",
          "parseTseungKwanOWeather"
        ]
      },
      "consumers": [
        {
          "file": "background.js",
          "symbols": [
            "normalizeSmartSensitivity",
            "computeSmartOnMinutes",
            "prepareSmartWeatherDecision",
            "consumeSmartWeatherDecision",
            "parseTseungKwanOWeather"
          ]
        },
        {
          "file": "popup.js",
          "symbols": [
            "normalizeSmartSensitivity",
            "computeSmartOnMinutes"
          ]
        }
      ]
    }
  ],
  "packaging": {
    "source": "build.sh",
    "runtimeFiles": [
      "manifest.json",
      "background.js",
      "content.js",
      "page-confirm.js",
      "popup.html",
      "popup.css",
      "popup.js",
      "popup-diagnostic-fallback.js",
      "i18n.js",
      "billing-helpers.js",
      "sync-helpers.js",
      "schedule-mutations.js",
      "pwm-retry.js",
      "pwm-phase.js",
      "smart-recovery.js",
      "interval-recovery.js",
      "recovery-coordinator.js",
      "smart-mode.js",
      "offscreen.html",
      "offscreen.js",
      "_locales",
      "icons"
    ]
  },
  "sourceRules": [
    {
      "name": "sync decisions remain browser independent",
      "files": ["sync-helpers.js"],
      "forbidPatterns": [
        "\\bchrome\\s*\\.",
        "\\bdocument\\s*\\.",
        "\\bwindow\\s*\\.",
        "\\blocalStorage\\b",
        "\\bimportScripts\\s*\\("
      ]
    },
    {
      "name": "balance decisions remain browser independent",
      "files": ["billing-helpers.js"],
      "forbidPatterns": [
        "\\bchrome\\s*\\.",
        "\\bdocument\\s*\\.",
        "\\bwindow\\s*\\.",
        "\\blocalStorage\\b",
        "\\bfetch\\s*\\("
      ]
    },
    {
      "name": "schedule clock mutations remain browser independent",
      "files": ["schedule-mutations.js"],
      "forbidPatterns": [
        "\\bchrome\\s*\\.",
        "\\bdocument\\s*\\.",
        "\\bwindow\\s*\\.",
        "\\blocalStorage\\b",
        "\\bfetch\\s*\\(",
        "\\bimportScripts\\s*\\("
      ]
    },
    {
      "name": "PWM retry descriptors remain browser independent",
      "files": ["pwm-retry.js"],
      "forbidPatterns": [
        "\\bchrome\\s*\\.",
        "\\bdocument\\s*\\.",
        "\\bwindow\\s*\\.",
        "\\blocalStorage\\b",
        "\\bfetch\\s*\\(",
        "\\bimportScripts\\s*\\("
      ]
    },
    {
      "name": "PWM phase decisions remain browser independent",
      "files": ["pwm-phase.js"],
      "forbidPatterns": [
        "\\bchrome\\s*\\.",
        "\\bdocument\\s*\\.",
        "\\bwindow\\s*\\.",
        "\\blocalStorage\\b",
        "\\bimportScripts\\s*\\("
      ]
    },
    {
      "name": "recovery decisions remain browser independent",
      "files": [
        "smart-recovery.js",
        "interval-recovery.js",
        "recovery-coordinator.js"
      ],
      "forbidPatterns": [
        "\\bchrome\\s*\\.",
        "\\bdocument\\s*\\.",
        "\\bwindow\\s*\\.",
        "\\blocalStorage\\b",
        "\\bfetch\\s*\\(",
        "\\bimportScripts\\s*\\("
      ]
    },
    {
      "name": "smart mode decisions remain browser independent",
      "files": ["smart-mode.js"],
      "forbidPatterns": [
        "\\bchrome\\s*\\.",
        "\\bdocument\\s*\\.",
        "\\bwindow\\s*\\.",
        "\\blocalStorage\\b",
        "\\bfetch\\s*\\(",
        "\\bimportScripts\\s*\\("
      ]
    },
    {
      "name": "smart weather control paths never invoke the fetch-capable reader",
      "files": ["background.js"],
      "forbidPatterns": [
        "await\\s+getSmartWeather\\s*\\(\\s*(?:\\)|\\{(?!\\s*force\\s*:\\s*true\\s*\\}))"
      ]
    },
    {
      "name": "automatic control remains behind the shared active-hours gate",
      "files": ["background.js"],
      "requirePatterns": [
        "function\\s+isAutomationAllowed\\s*\\(",
        "const\\s+AUTOMATION_RUNTIME_ALARMS\\s*=\\s*new\\s+Set",
        "isAutomationRuntimeAlarm\\s*&&\\s*!isAutomationAllowed\\s*\\(\\s*\\)",
        "requireAutomationAllowed\\s*:\\s*true",
        "function\\s+isAutomationOperationCurrent\\s*\\(",
        "async\\s+function\\s+clearAutomationRuntimeAlarmsWhileBlocked\\s*\\("
      ]
    },
    {
      "name": "popup fallback diagnostics remain read only and privacy safe",
      "files": ["popup-diagnostic-fallback.js"],
      "requirePatterns": [
        "function\\s+recordPopupError\\s*\\(",
        "function\\s+runFallbackDiagnostic\\s*\\(",
        "chrome\\s*\\.\\s*storage\\s*\\.\\s*local\\s*\\.\\s*get",
        "chrome\\s*\\.\\s*alarms\\s*\\.\\s*getAll",
        "sendFallbackRuntimeMessage\\s*\\("
      ],
      "forbidPatterns": [
        "chrome\\s*\\.\\s*storage\\s*\\.\\s*(?:local|sync)\\s*\\.\\s*set",
        "chrome\\s*\\.\\s*alarms\\s*\\.\\s*(?:create|clear)",
        "location\\s*\\.\\s*href",
        "\\.\\s*innerText",
        "balanceMinutes",
        "actualStatus"
      ]
    },
    {
      "name": "popup preserves the active-hours pause state",
      "files": ["popup.js"],
      "requirePatterns": [
        "function\\s+syncActiveHoursUI\\s*\\(",
        "_automationPausedByActiveHours\\s*===\\s*true",
        "currentScheduleEnabled\\s*=\\s*true"
      ]
    },
    {
      "name": "popup delegates alarm repair to the gated service worker",
      "files": ["popup.js"],
      "forbidPatterns": [
        "\\bchrome\\s*\\.\\s*alarms\\s*\\.\\s*create\\s*\\("
      ]
    },
    {
      "name": "popup weather reads remain storage only",
      "files": ["popup.js"],
      "forbidPatterns": [
        "\\bfetch\\s*\\(",
        "refreshSmartWeather",
        "\\bgetSmartWeather\\s*\\("
      ]
    },
    {
      "name": "main-world adapter has no extension privileges",
      "files": ["page-confirm.js"],
      "forbidPatterns": ["\\bchrome\\s*\\."]
    },
    {
      "name": "service worker has no DOM dependency",
      "files": ["background.js"],
      "forbidPatterns": ["\\bdocument\\s*\\.", "\\bwindow\\s*\\."]
    }
  ]
}
