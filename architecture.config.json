{
  "schemaVersion": 1,
  "entrypoints": {
    "serviceWorker": {
      "file": "background.js",
      "imports": ["i18n.js", "sync-helpers.js", "schedule-mutations.js", "smart-retry.js", "pwm-retry.js", "pwm-phase.js", "smart-phase.js", "smart-recovery.js", "interval-recovery.js", "recovery-coordinator.js", "smart-mode.js"]
    },
    "contentScripts": [
      {
        "matches": ["https://w5.ab.ust.hk/njggt/app/home"],
        "js": ["page-confirm.js"],
        "run_at": "document_start",
        "world": "MAIN",
        "all_frames": false
      },
      {
        "matches": ["https://w5.ab.ust.hk/njggt/app/home"],
        "js": ["billing-helpers.js", "content.js"],
        "run_at": "document_idle",
        "all_frames": false
      }
    ],
    "documents": [
      {
        "file": "popup.html",
        "scripts": ["i18n.js", "billing-helpers.js", "smart-mode.js", "popup-diagnostic-fallback.js", "popup.js"]
      },
      {
        "file": "offscreen.html",
        "scripts": ["offscreen.js"]
      }
    ],
    "dynamicInjections": [
      {
        "source": "background.js",
        "files": ["billing-helpers.js", "content.js"]
      },
      {
        "source": "background.js",
        "files": ["page-confirm.js"]
      }
    ]
  },
  "interfaces": [
    {
      "name": "translations",
      "provider": {
        "file": "i18n.js",
        "symbols": ["I18n"]
      },
      "consumers": [
        {
          "file": "background.js",
          "symbols": ["I18n"]
        },
        {
          "file": "popup.js",
          "symbols": ["I18n"]
        }
      ]
    },
    {
      "name": "balance decisions",
      "provider": {
        "file": "billing-helpers.js",
        "symbols": [
          "parseBalanceMinutes",
          "estimateBalanceExhaustion",
          "isBalanceEstimateUrgent"
        ]
      },
      "consumers": [
        {
          "file": "content.js",
          "symbols": ["parseBalanceMinutes"]
        },
        {
          "file": "popup.js",
          "symbols": ["estimateBalanceExhaustion", "isBalanceEstimateUrgent"]
        }
      ]
    },
    {
      "name": "schedule sync decisions",
      "provider": {
        "file": "sync-helpers.js",
        "symbols": [
          "composeSyncPayload",
          "computePhaseAdoption",
          "computeConfigDiff",
          "parsePageTimerValue",
          "isPageTimerProofFresh",
          "computePageTimerAdoption"
        ]
      },
      "consumers": [
        {
          "file": "background.js",
          "symbols": [
            "composeSyncPayload",
            "computePhaseAdoption",
            "computeConfigDiff",
            "isPageTimerProofFresh",
            "computePageTimerAdoption"
          ]
        }
      ]
    },
    {
      "name": "PWM phase decisions",
      "provider": {
        "file": "pwm-phase.js",
        "symbols": [
          "planPwmStep",
          "planPwmRecovery",
          "reconcilePwmTrigger"
        ]
      },
      "consumers": [
        {
          "file": "background.js",
          "symbols": [
            "planPwmStep",
            "planPwmRecovery",
            "reconcilePwmTrigger"
          ]
        }
      ]
    },
      {
        "name": "Smart phase decisions",
        "provider": {
          "file": "smart-phase.js",
          "symbols": [
            "planSmartStep",
            "planComfortSmartCycle",
            "smartPageTimerTargetAt",
            "smartModePageTimerTargetAt",
            "normalizeSmartHalfHourAlarmBoundary",
            "nextSafeSmartPageTimerTargetAt",
            "isSmartHalfHourBoundary",
            "nextSmartHalfHourBoundary",
            "normalizeHalfHourAlarmBoundary",
            "nextHalfHourBoundary",
            "planNextSmartWeatherPrefetch",
            "smartWeatherTargetBoundaryAt",
            "planSmartModeOnWindow",
            "planSmartOnRetryExceptionRecovery",
            "planSmartOnAfterConfirmedOff",
            "classifySmartOnClock",
            "alignSmartModeNextTrigger"
          ]
        },
        "consumers": [
          {
            "file": "background.js",
            "symbols": [
              "planSmartStep",
              "planComfortSmartCycle",
              "smartPageTimerTargetAt",
              "smartModePageTimerTargetAt",
              "normalizeSmartHalfHourAlarmBoundary",
              "nextSafeSmartPageTimerTargetAt",
              "isSmartHalfHourBoundary",
              "nextSmartHalfHourBoundary",
              "normalizeHalfHourAlarmBoundary",
              "nextHalfHourBoundary",
              "planNextSmartWeatherPrefetch",
              "smartWeatherTargetBoundaryAt",
              "planSmartModeOnWindow",
              "planSmartOnRetryExceptionRecovery",
              "planSmartOnAfterConfirmedOff",
              "classifySmartOnClock",
              "alignSmartModeNextTrigger"
            ]
          },
          {
            "file": "smart-recovery.js",
            "symbols": ["planSmartModeOnWindow", "classifySmartOnClock"]
          }
        ]
    },
    {
      "name": "Smart retry decisions",
      "provider": {
        "file": "smart-retry.js",
        "symbols": [
          "SMART_RETRY_KINDS",
          "getSmartRetryDescriptor",
          "normalizeSmartRetryKind"
        ]
      },
      "consumers": [
        {
          "file": "smart-phase.js",
          "symbols": ["getSmartRetryDescriptor"]
        },
        {
          "file": "background.js",
          "symbols": ["SMART_RETRY_KINDS", "getSmartRetryDescriptor"]
        }
      ]
    },
    {
      "name": "PWM retry decisions",
      "provider": {
        "file": "pwm-retry.js",
        "symbols": [
          "PWM_RETRY_KINDS",
          "getPwmRetryDescriptor",
          "normalizePwmRetryKind"
        ]
      },
      "consumers": [
        {
          "file": "background.js",
          "symbols": ["PWM_RETRY_KINDS", "getPwmRetryDescriptor"]
        }
      ]
    },
    {
      "name": "PWM schedule namespace mutations",
      "provider": {
        "file": "schedule-mutations.js",
        "symbols": [
          "setSchedulePwmClockIntent",
          "replaceSchedulePwmRetryState"
        ]
      },
      "consumers": [
        {
          "file": "background.js",
          "symbols": [
            "setSchedulePwmClockIntent",
            "replaceSchedulePwmRetryState"
          ]
        }
      ]
    },
    {
      "name": "Smart schedule namespace mutations",
      "provider": {
        "file": "schedule-mutations.js",
        "symbols": [
          "setScheduleSmartClockIntent",
          "replaceScheduleSmartRetryState"
        ]
      },
      "consumers": [
        {
          "file": "background.js",
          "symbols": [
            "setScheduleSmartClockIntent",
            "replaceScheduleSmartRetryState"
          ]
        }
      ]
    },
    {
      "name": "smart mode decisions",
      "provider": {
        "file": "smart-mode.js",
        "symbols": [
          "normalizeSmartSensitivity",
          "computeSmartOnMinutes",
          "prepareSmartWeatherDecision",
          "consumeSmartWeatherDecision",
          "sensitivityToK",
          "equivalentTemperature",
          "parseTseungKwanOWeather"
        ]
      },
      "consumers": [
        {
          "file": "background.js",
          "symbols": [
            "normalizeSmartSensitivity",
            "computeSmartOnMinutes",
            "prepareSmartWeatherDecision",
            "consumeSmartWeatherDecision",
            "parseTseungKwanOWeather"
          ]
        },
        {
          "file": "popup.js",
          "symbols": [
            "normalizeSmartSensitivity",
            "computeSmartOnMinutes"
          ]
        }
      ]
    }
  ],
  "packaging": {
    "source": "build.sh",
    "runtimeFiles": [
      "manifest.json",
      "background.js",
      "content.js",
      "page-confirm.js",
      "popup.html",
      "popup.css",
      "popup.js",
      "popup-diagnostic-fallback.js",
      "i18n.js",
      "billing-helpers.js",
      "ac-page-contract.js",
      "sync-helpers.js",
      "schedule-mutations.js",
      "smart-retry.js",
      "pwm-retry.js",
      "pwm-phase.js",
      "smart-phase.js",
      "smart-recovery.js",
      "interval-recovery.js",
      "recovery-coordinator.js",
      "smart-mode.js",
      "offscreen.html",
      "offscreen.js",
      "_locales",
      "icons"
    ]
  },
  "sourceRules": [
    {
      "name": "sync decisions remain browser independent",
      "files": ["sync-helpers.js"],
      "forbidPatterns": [
        "\\bchrome\\s*\\.",
        "\\bdocument\\s*\\.",
        "\\bwindow\\s*\\.",
        "\\blocalStorage\\b",
        "\\bimportScripts\\s*\\("
      ]
    },
    {
      "name": "balance decisions remain browser independent",
      "files": ["billing-helpers.js"],
      "forbidPatterns": [
        "\\bchrome\\s*\\.",
        "\\bdocument\\s*\\.",
        "\\bwindow\\s*\\.",
        "\\blocalStorage\\b",
        "\\bfetch\\s*\\("
      ]
    },
    {
      "name": "schedule mutations remain browser independent",
      "files": ["schedule-mutations.js"],
      "forbidPatterns": [
        "\\bchrome\\s*\\.",
        "\\bdocument\\s*\\.",
        "\\bwindow\\s*\\.",
        "\\blocalStorage\\b",
        "\\bfetch\\s*\\(",
        "\\bimportScripts\\s*\\("
      ]
    },
    {
      "name": "Smart schedule mutations do not write PWM namespace",
      "files": ["schedule-mutations.js"],
      "forbidPatterns": [
        "function\\s+setScheduleSmartClockIntent\\b(?:(?!\\n\\s*function\\s)[\\s\\S])*\\b(?:pwmClockPlannedAt|alarmCreatedAt|pwmRetry(?:Kind|BoundaryAt|ScheduledAt)|pwmState)\\b",
        "function\\s+replaceScheduleSmartRetryState\\b(?:(?!\\n\\s*function\\s)[\\s\\S])*\\bpwmRetry(?:Kind|BoundaryAt|ScheduledAt)\\b"
      ]
    },
    {
      "name": "PWM schedule mutations do not write Smart namespace",
      "files": ["schedule-mutations.js"],
      "forbidPatterns": [
        "function\\s+setSchedulePwmClockIntent\\b(?:(?!\\n\\s*function\\s)[\\s\\S])*\\b(?:smartClockPlannedAt|smartNextTriggerAt|smartRetry(?:Kind|BoundaryAt|ScheduledAt)|smartState)\\b",
        "function\\s+replaceSchedulePwmRetryState\\b(?:(?!\\n\\s*function\\s)[\\s\\S])*\\bsmartRetry(?:Kind|BoundaryAt|ScheduledAt)\\b"
      ]
    },
    {
      "name": "PWM phase decisions remain browser independent",
      "files": ["pwm-phase.js"],
      "forbidPatterns": [
        "\\bchrome\\s*\\.",
        "\\bdocument\\s*\\.",
        "\\bwindow\\s*\\.",
        "\\blocalStorage\\b",
        "\\bimportScripts\\s*\\("
      ]
    },
    {
      "name": "Smart phase and recovery never depend on PWM molecules",
      "files": ["smart-phase.js", "smart-recovery.js"],
      "forbidPatterns": [
        "pwm-phase\\.js",
        "\\bplanPwm(?:Step|Recovery)\\b",
        "\\brunPwmStep\\b"
      ]
    },
    {
      "name": "Smart molecules never depend on PWM retry",
      "files": ["smart-phase.js", "smart-recovery.js"],
      "forbidPatterns": [
        "pwm-retry\\.js",
        "\\bPWM_RETRY(?:_KINDS|_DESCRIPTORS)?\\b",
        "\\b(?:get|normalize)PwmRetry(?:Descriptor|Kind)\\b",
        "\\bpwmRetry(?:Kind|BoundaryAt|ScheduledAt)?\\b"
      ]
    },
    {
      "name": "PWM phase and interval recovery never depend on Smart molecules",
      "files": ["pwm-phase.js", "interval-recovery.js"],
      "forbidPatterns": [
        "smart-phase\\.js",
        "\\bplanSmart(?:Step|ModeOnWindow|OnAfterConfirmedOff|OnRetryExceptionRecovery)\\b",
        "\\bclassifySmartOnClock\\b",
        "\\brunSmartStep\\b"
      ]
    },
    {
      "name": "PWM molecules never depend on Smart retry",
      "files": ["pwm-phase.js", "interval-recovery.js"],
      "forbidPatterns": [
        "smart-retry\\.js",
        "\\bSMART_RETRY(?:_KINDS|_DESCRIPTORS)?\\b",
        "\\b(?:get|normalize)SmartRetry(?:Descriptor|Kind)\\b",
        "\\bsmartRetry(?:Kind|BoundaryAt|ScheduledAt)?\\b"
      ]
    },
    {
      "name": "PWM retry has no Smart retry semantics",
      "files": ["pwm-retry.js"],
      "forbidPatterns": [
        "\\bSMART_RETRY(?:_KINDS|_DESCRIPTORS)?\\b",
        "\\b(?:get|normalize)SmartRetry(?:Descriptor|Kind)\\b",
        "\\bsmartRetry(?:Kind|BoundaryAt|ScheduledAt)?\\b",
        "\\bsmart-(?:on|safety)[\\w-]*\\b"
      ]
    },
    {
      "name": "Smart retry has no PWM retry semantics",
      "files": ["smart-retry.js"],
      "forbidPatterns": [
        "\\bPWM_RETRY(?:_KINDS|_DESCRIPTORS)?\\b",
        "\\b(?:get|normalize)PwmRetry(?:Descriptor|Kind)\\b",
        "\\bpwmRetry(?:Kind|BoundaryAt|ScheduledAt)?\\b",
        "\\bpwm-(?:page-timer|toggle)[\\w-]*\\b"
      ]
    },
    {
      "name": "smart mode decisions remain browser independent",
      "files": ["smart-mode.js"],
      "forbidPatterns": [
        "\\bchrome\\s*\\.",
        "\\bdocument\\s*\\.",
        "\\bwindow\\s*\\.",
        "\\blocalStorage\\b",
        "\\bfetch\\s*\\(",
        "\\bimportScripts\\s*\\("
      ]
    },
    {
      "name": "smart weather control paths never invoke the fetch-capable reader",
      "files": ["background.js"],
      "forbidPatterns": [
        "await\\s+getSmartWeather\\s*\\(\\s*(?:\\)|\\{(?!\\s*force\\s*:\\s*true\\s*\\}))"
      ]
    },
    {
      "name": "automatic control remains behind the shared active-hours gate",
      "files": ["background.js"],
      "requirePatterns": [
        "function\\s+isAutomationAllowed\\s*\\(",
        "const\\s+AUTOMATION_RUNTIME_ALARMS\\s*=\\s*new\\s+Set",
        "isAutomationRuntimeAlarm\\s*&&\\s*!isAutomationAllowed\\s*\\(\\s*\\)",
        "requireAutomationAllowed\\s*:\\s*true",
        "function\\s+isAutomationOperationCurrent\\s*\\(",
        "async\\s+function\\s+clearAutomationRuntimeAlarmsWhileBlocked\\s*\\("
      ]
    },
    {
      "name": "popup preserves the active-hours pause state",
      "files": ["popup.js"],
      "requirePatterns": [
        "function\\s+syncActiveHoursUI\\s*\\(",
        "_automationPausedByActiveHours\\s*===\\s*true",
        "currentScheduleEnabled\\s*=\\s*true"
      ]
    },
    {
      "name": "popup delegates alarm repair to the gated service worker",
      "files": ["popup.js"],
      "forbidPatterns": [
        "\\bchrome\\s*\\.\\s*alarms\\s*\\.\\s*create\\s*\\("
      ]
    },
    {
      "name": "popup weather reads remain storage only",
      "files": ["popup.js"],
      "forbidPatterns": [
        "\\bfetch\\s*\\(",
        "refreshSmartWeather",
        "\\bgetSmartWeather\\s*\\("
      ]
    },
    {
      "name": "main-world adapter has no extension privileges",
      "files": ["page-confirm.js"],
      "forbidPatterns": ["\\bchrome\\s*\\."]
    },
    {
      "name": "service worker has no DOM dependency",
      "files": ["background.js"],
      "forbidPatterns": ["\\bdocument\\s*\\.", "\\bwindow\\s*\\."]
    }
  ]
}
