      "files": ["pwm-phase.js"],
      "forbidPatterns": [
        "\\bchrome\\s*\\.",
        "\\bdocument\\s*\\.",
        "\\bwindow\\s*\\.",
        "\\blocalStorage\\b",
        "\\bimportScripts\\s*\\("
      ]
    },
    {
      "name": "recovery decisions remain browser independent",
      "files": [
        "smart-recovery.js",
        "interval-recovery.js",
        "recovery-coordinator.js"
      ],
      "forbidPatterns": [
        "\\bchrome\\s*\\.",
        "\\bdocument\\s*\\.",
        "\\bwindow\\s*\\.",
        "\\blocalStorage\\b",
        "\\bfetch\\s*\\(",
        "\\bimportScripts\\s*\\("
      ]
    },
    {
      "name": "smart mode decisions remain browser independent",
      "files": ["smart-mode.js"],
      "forbidPatterns": [
