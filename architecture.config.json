    },
    {
      "name": "popup preserves the active-hours pause state",
      "files": ["popup.js"],
      "requirePatterns": [
        "function\\s+syncActiveHoursUI\\s*\\(",
        "_automationPausedByActiveHours\\s*===\\s*true",
        "currentScheduleEnabled\\s*=\\s*true"
      ]
    },
    {
      "name": "popup delegates alarm repair to the gated service worker",
      "files": ["popup.js"],
      "forbidPatterns": [
