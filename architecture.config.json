    },
    {
      "name": "balance decisions remain browser independent",
      "files": ["billing-helpers.js"],
      "forbidPatterns": [
        "\\bchrome\\s*\\.",
        "\\bdocument\\s*\\.",
        "\\bwindow\\s*\\.",
        "\\blocalStorage\\b",
        "\\bfetch\\s*\\("
      ]
    },
    {
      "name": "AC page semantics remain browser independent",
      "files": ["ac-page-contract.js"],
      "forbidPatterns": [
        "\\bchrome\\s*\\.",
