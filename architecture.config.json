  "sourceRules": [
    {
      "name": "sync decisions remain browser independent",
      "files": ["sync-helpers.js"],
      "forbidPatterns": [
        "\\bchrome\\s*\\.",
        "\\bdocument\\s*\\.",
        "\\bwindow\\s*\\.",
        "\\blocalStorage\\b",
        "\\bimportScripts\\s*\\("
